# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
# cp .env.example .env
# 실제 비밀값(JWT_SECRET, *_CLIENT_SECRET, DB_PASSWORD 등)은 팀 슬랙/노션 등으로 별도 공유받으세요.

# Database
DB_USERNAME=
DB_PASSWORD=

# JWT (32자 이상 무작위 문자열 권장)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_EXPIRATION=36000000
JWT_REFRESH_EXPIRATION=604800000

# Kakao OAuth (카카오 개발자 콘솔에서 발급)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/kakao/oauth

# Naver OAuth (네이버 개발자센터에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:5173/naver/oauth

# User
WITHDRAWAL_RETENTION_DAYS=180

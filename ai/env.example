# cp .env.example .env

# 테스트 전용 엔드포인트(/chat/simple) 활성화 여부. 운영에서는 반드시 false(기본값).
ENABLE_TEST_ENDPOINTS=false

# KoBART 판례요약 체크포인트 경로 (컨테이너 내부 기준 경로, docker-compose 볼륨 마운트와 맞출 것)
KOBART_CHECKPOINT=kobart/checkpoint-26606
# 체크포인트 폴더 안에 tokenizer 파일이 없는 경우에만 지정 (README 참고)
# KOBART_TOKENIZER=kobart

# RAG 검색 후보(점수 + 내용 일부)를 로그로 볼지 여부. 기본 false, 필요할 때만 true로 켜서 확인.
# RAG_DEBUG=true

# dense 검색 score threshold (낮을수록 더 유사하다고 판단된 것만 통과). 기본 1.0.
# 사실관계가 다른 판례가 자꾸 걸려 들어올 때, RAG_DEBUG로 실제 점수 확인 후 이 값을 조정해서 테스트.
# RAG_SCORE_THRESHOLD=1.0
